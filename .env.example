# Copy to .env and fill in. Used by docker-compose and the scripts.
# Any value here overrides the matching field in poe_control_config.json.

# Required: EdgeSwitch admin password (also used as the "enable" password).
POE_PASSWORD=

# Optional: path to a non-default config file.
# POE_CONFIG_PATH=/path/to/poe_control_config.json

# Optional: override the MQTT broker host/port from the config.
# MQTT_BROKER=192.0.2.10
# MQTT_PORT=1883
